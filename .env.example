# Copy this file to .env and fill in the values.

# --- Shopify app (Partner dashboard) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_script_tags

# Public URL of this app (Railway domain, no trailing slash)
APP_URL=https://your-app.up.railway.app

# --- Database (Railway PostgreSQL addon) ---
DATABASE_URL=

# --- Stripe ---
# Secret key of the PLATFORM Stripe account (sk_live_... / sk_test_...)
STRIPE_SECRET_KEY=
# Connect client ID (ca_...) from Stripe Dashboard > Connect settings
STRIPE_CONNECT_CLIENT_ID=
# Signing secret of the CONNECT webhook endpoint (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Port (Railway sets it automatically)
PORT=3000
